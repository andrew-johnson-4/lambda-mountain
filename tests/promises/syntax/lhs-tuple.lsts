
import lib/core/bedrock.lsts;

(let xx, let yy) = (1, 2);
assert(xx == 1);
assert(yy == 2);

(xx, yy) = (3, 4);
assert(xx == 3);
assert(yy == 4);

(let x1, let y1, let z1) = (1, 2, 3);
assert( x1 == 1 );
assert( y1 == 2 );
assert( z1 == 3 );

((let a1, let b1), let c1) = ((10, 20), 30);
assert( a1 == 10 );
assert( b1 == 20 );
assert( c1 == 30 );

(_, let x2) = (0, 42);
assert( x2 == 42 );
