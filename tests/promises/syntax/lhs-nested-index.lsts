
import lib/core/bedrock.lsts;

type A = { x: U8, y: U8 };

let xs = safe-alloc(2, type(A));
xs[0] = A(1,2);
xs[1] = A(2,3);

assert( xs[0].x == 1 );
assert( xs[0].y == 2 );

assert( xs[1].x == 2 );
assert( xs[1].y == 3 );

xs[0] = A(3,4);

assert( xs[0].x == 3 );
assert( xs[0].y == 4 );

assert( xs[1].x == 2 );
assert( xs[1].y == 3 );

xs[0].x = 5;

assert( xs[0].x == 5 );
assert( xs[0].y == 4 );

assert( xs[1].x == 2 );
assert( xs[1].y == 3 );

