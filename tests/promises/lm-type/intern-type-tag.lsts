
import SRC/unit-type-core.lsts;

assert( intern-type-tag(c"A") == TypeTagIntern(1_u64,0_u64) );
assert( intern-type-tag(c"A") == TypeTagIntern(1_u64,0_u64) );
assert( intern-type-tag(c"B") == TypeTagIntern(2_u64,0_u64) );
assert( intern-type-tag(c"C::D") == TypeTagIntern(3_u64,4_u64) );
assert( intern-type-tag(c"C::E") == TypeTagIntern(3_u64,5_u64) );
assert( intern-type-tag(c"C::") == TypeTagIntern(3_u64,0_u64) );
assert( intern-type-tag(c"C::D") == intern-type-tag(c"C::") );
assert( intern-type-tag(c"C::") == intern-type-tag(c"C::D") );
assert( not intern-type-tag(c"C::D") == intern-type-tag(c"C::E") );
