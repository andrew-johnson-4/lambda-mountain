
import SRC/unit-codegen-core.lsts;
import SRC/unit-backend-core.lsts;
import PLUGINS/FRONTEND/C/index.lsts;
import PLUGINS/FRONTEND/LSTS/index.lsts;
import PLUGINS/BACKEND/C/index.lsts;

ast-parsed-program = mk-eof();
frontend(c"lib/core/nocode.lsts");
lsts-parse(lsts-tokenize-string(c"tests/promises/backend/initialize.lsts",c"import stdio.h;"));
typecheck();
assert( render-includes(ast-parsed-program) == "#include <stdio.h>\n" );
