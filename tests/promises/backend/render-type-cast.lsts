
import SRC/unit-codegen-core.lsts;
import PLUGINS/FRONTEND/LSTS/index.lsts;

ast-parsed-program = mk-eof();
frontend(c"lib/core/nocode.lsts");
lsts-parse(lsts-tokenize-string(c"tests/promises/backend/initialize.lsts",c"type B = {};"));
lsts-parse(lsts-tokenize-string(c"tests/promises/backend/initialize.lsts",c"l\"A\" as B;"));
typecheck();
print(render(ast-parsed-program));
assert( render(ast-parsed-program) == "((LM_B)(A))" );
