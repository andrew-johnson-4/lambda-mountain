
import lib/core/bedrock.lsts;

if true then (
   let b1 = mk-pbtree(type(U8), type(U8));
   let b2 = b1.bind(1, 2);
   let b3 = b2.bind(2, 3);
   let b4 = b3.bind(3, 4);
   let b5 = b4.bind(1, 3);
   let b6 = b2.bind(1, 5);
   assert( b1.lookup(1, 0) == 0 );
   assert( b1.lookup(2, 0) == 0 );
   assert( b1.lookup(3, 0) == 0 );
   assert( b2.lookup(1, 0) == 2 );
   assert( b2.lookup(2, 0) == 0 );
   assert( b2.lookup(3, 0) == 0 );
   assert( b3.lookup(1, 0) == 2 );
   assert( b3.lookup(2, 0) == 3 );
   assert( b3.lookup(3, 0) == 0 );
   assert( b4.lookup(1, 0) == 2 );
   assert( b4.lookup(2, 0) == 3 );
   assert( b4.lookup(3, 0) == 4 );
   assert( b5.lookup(1, 0) == 3 );
   assert( b5.lookup(2, 0) == 3 );
   assert( b5.lookup(3, 0) == 4 );
   assert( b6.lookup(1, 0) == 5 );
   assert( b6.lookup(2, 0) == 0 );
   assert( b6.lookup(3, 0) == 0 );
);
assert( safe-alloc-block-count == 0 );

if true then (
   let b1 = mk-pbtree(type(String), type(String));
   let b2 = b1.bind("1", "2");
   let b3 = b2.bind("2", "3");
   let b4 = b3.bind("3", "4");
   let b5 = b4.bind("1", "3");
   let b6 = b2.bind("1", "5");
   assert( b1.lookup("1", "0") == "0" );
   assert( b1.lookup("2", "0") == "0" );
   assert( b1.lookup("3", "0") == "0" );
   assert( b2.lookup("1", "0") == "2" );
   assert( b2.lookup("2", "0") == "0" );
   assert( b2.lookup("3", "0") == "0" );
   assert( b3.lookup("1", "0") == "2" );
   assert( b3.lookup("2", "0") == "3" );
   assert( b3.lookup("3", "0") == "0" );
   assert( b4.lookup("1", "0") == "2" );
   assert( b4.lookup("2", "0") == "3" );
   assert( b4.lookup("3", "0") == "4" );
   assert( b5.lookup("1", "0") == "3" );
   assert( b5.lookup("2", "0") == "3" );
   assert( b5.lookup("3", "0") == "4" );
   assert( b6.lookup("1", "0") == "5" );
   assert( b6.lookup("2", "0") == "0" );
   assert( b6.lookup("3", "0") == "0" );
);
assert( safe-alloc-block-count == 0 );
