
import lib/core/bedrock.lsts;

type A = {a:U8} | B{b:U8} | C{c:U8,d:U8};
type D = {a: U8, b: U8, c: U8, d: U8};

let cases-count = 0;

cases-count = 0;
for case in $cases-of(B(1,2)) { cases-count = cases-count + 1; };
assert( cases-count == 2 );

cases-count = 0;
for case in $cases-of(C(1,2,3)) { cases-count = cases-count + 1; };
assert( cases-count == 2 );

cases-count = 0;
for case in $cases-of(B(1,2) as Tag::B) { cases-count = cases-count + 1; };
assert( cases-count == 2 );

cases-count = 0;
for case in $cases-of(C(1,2,3) as Tag::C) { cases-count = cases-count + 1; };
assert( cases-count == 2 );

cases-count = 0;
for case in $cases-of(D(1,2,3,4)) { cases-count = cases-count + 1; };
assert( cases-count == 1 );
