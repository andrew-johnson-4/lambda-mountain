
let .lookup(tctx: TypeContext?, key: CString): TypeContextRow = tctx.get-or(mk-tctx()).tctx.lookup(key);
let .lookup(trs: List<TypeContextRow>, key: CString): TypeContextRow = (
   let default = NullTypeContextRow;
   let continue = true;
   while non-zero(trs) and continue {
      let tr = head(trs); trs = tail(trs);
      if tr.key-or-zero == key {
         default = tr;
         continue = false;
      }
   };
   if not(non-zero(default)) {
      for tr in global-tctx.lookup(key, mk-vector(type(TypeContextRow)) ) {
         if tr.key-or-zero == key {
            if non-zero(default) {
               eprint("Duplicate Global Symbol \{key}\n");
               eprint("At \{default.blame-or-zero.location}\n");
               eprint("And \{tr.blame-or-zero.location}\n");
               exit(1);
            };
            default = tr;
         }
      };
   };
   default
);

let .lookups(tctx: TypeContext?, key: CString): Vector<TypeContextRow> = tctx.get-or(mk-tctx()).tctx.lookups(key);
let .lookups(trs: List<TypeContextRow>, key: CString): Vector<TypeContextRow> = (
   let default = mk-vector(type(TypeContextRow));
   let continue = true;
   while non-zero(trs) and continue {
      let tr = head(trs); trs = tail(trs);
      if tr.key-or-zero == key {
         default = default.push(tr);
         continue = false;
      }
   };
   if continue {
      for tr in global-tctx.lookup(key, mk-vector(type(TypeContextRow)) ) {
         if tr.key-or-zero == key {
            default = default.push(tr);
         }
      };
   };
   default
);

let .lookups-first(tctx: TypeContext?, key: CString): TypeContextRow = tctx.get-or(mk-tctx()).tctx.lookups-first(key);
let .lookups-first(trs: List<TypeContextRow>, key: CString): TypeContextRow = (
   let default = NullTypeContextRow;
   while non-zero(trs) and not(non-zero(default)) {
      let tr = head(trs); trs = tail(trs);
      if tr.key-or-zero == key {
         default = tr;
      }
   };
   if not(non-zero(default)) {
      for tr in global-tctx.lookup(key, mk-vector(type(TypeContextRow)) ) {
         if tr.key-or-zero == key and not(non-zero(default)) {
            default = tr;
         }
      };
   };
   default
);

let .lookup-phi(tctx: TypeContext?, key: U64): PhiContextRow = tctx.get-or(mk-tctx()).pctx.lookup(key, NullPhiContextRow);

let .lookup(tree: PBTree<U64,PhiContextRow>, key: U64, default: PhiContextRow): PhiContextRow = (
   match tree {
      PBLeaf {} => default;
      PBNode1 { k11=k1, v11=v1, left=left, right=right } => (
         if key == k11 then default = v11;
         if (not(non-zero(default)) or default.dead-on-arrival-or-zero) and key < k11 then default = left.lookup(key, default);
         if (not(non-zero(default)) or default.dead-on-arrival-or-zero) and key >= k11 then default = right.lookup(key, default);
         default;
      );
      PBNode2 { k12=k1, v12=v1, k22=k2, v22=v2, left=left, mid=mid, right=right } => (
         if key == k12 then default = v12;
         else if key == k22 then default = v22;
         if (not(non-zero(default)) or default.dead-on-arrival-or-zero) and key < k12 then default = left.lookup(key, default);
         if (not(non-zero(default)) or default.dead-on-arrival-or-zero) and key >= k12 and key < k22 then default = mid.lookup(key, default);
         if (not(non-zero(default)) or default.dead-on-arrival-or-zero) and key >= k22 then default = right.lookup(key, default);
         default;
      );
   }
);
