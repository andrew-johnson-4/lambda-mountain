
let .resurrect(tt: Type): Type = (
   match tt {
      TGround{tag:interned-tag-linear, parameters:[TGround{tag:interned-tag-phi-moved,parameters:[]}..]} => (
         type-linear-live
      );
      TGround{tag=tag, parameters=parameters} => (
         ts(tag, parameters.resurrect);
      );
      _ => tt;
   }
);

let .resurrect(tt: Vector<Type>): Vector<Type> = (
   let next = mk-vector(type(Type));
   for t in tt {
      next = next.push(t.resurrect);
   };
   next
);

