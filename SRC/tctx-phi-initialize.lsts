
let .phi-initialize(tctx: TypeContext?, tt: Type, blame: AST): (TypeContext?, Type) = (
   match tt {
      TAnd{conjugate=conjugate} => (
         let new-conjugate = mk-vector(type(Type), conjugate.length);
         for c in conjugate {
            (tctx, c) = tctx.phi-initialize(c, blame);
            if non-zero(c) then new-conjugate = new-conjugate.push(c);
         };
         (tctx, tand(new-conjugate))
      );
      TGround{tag:interned-tag-phi-state,parameters:[init-tt..]} => (
         let phi-id = iuid();
         tctx = tctx.bind-phi(phi-id, init-tt, blame);
         (tctx, t1(interned-tag-phi-id,ti(phi-id)))
      );
      TGround{tag:interned-tag-cons,parameters:[p2..p1..]} => (
         (tctx, p1) = tctx.phi-initialize(p1, blame);
         (tctx, p2) = tctx.phi-initialize(p2, blame);
         (tctx, t2(interned-tag-cons,p1,p2))
      );
      _ => (tctx, tt);
   };
);
