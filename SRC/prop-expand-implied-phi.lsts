
let implied-phi-index = {} : Hashtable<(U32,U32),Type>;

let .expand-implied-phi(tt: Type): Type = (
   let original-tt = tt;
   if not(tt.is-t(interned-tag-phi-state,1)) then match tt {
      TAnd{conjugate=conjugate} => (
         tt = tand(conjugate);
         for c in conjugate {
            let ga = c.ground-tag-and-arity;
            let ip = implied-phi-index.lookup(ga,ta);
            let ps = t1(interned-tag-phi-state,ip);
            if non-zero(ip) and not(can-unify(ps, tt)) {
               tt = tt.extend(ps)
            }
         }
      );
      TGround{tag:interned-tag-cons,parameters:[t1..t0..]} => (
         tt = t2(interned-tag-cons, t0.expand-implied-phi, t1.expand-implied-phi);
      );
      TGround{} => (
         let ga = tt.ground-tag-and-arity;
         let ip = implied-phi-index.lookup(ga,ta);
         let ps = t1(interned-tag-phi-state,ip);
         if non-zero(ip) and not(can-unify(ps, tt)) {
            tt = tt.extend(ps)
         }
      );
      _ => ();
   };
   tt
);
