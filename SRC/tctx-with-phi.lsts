
let .with-phi(tctx: TypeContext?, tt: Type, blame: AST): Type = (
   if tt.is-t(interned-tag-cons,2) {
      let ct = tt.slot(interned-tag-cons,2);
      tt = t2(interned-tag-cons, tctx.with-phi(ct.l1,blame), tctx.with-phi(ct.l2,blame));
   } else if tt.is-t(interned-tag-phi-id,1) {
      let phi-state = tctx.lookup-phi(tt.slot(interned-tag-phi-id,1).l1.simple-id).phi-tt-or-zero;
      if not(non-zero(phi-state)) then phi-state = type-release-phi-moved;
      if tt.is-t(interned-tag-phi-state,1) and tt.slot(interned-tag-phi-state,1).l1 != phi-state
      then tt = tt.without-slot(interned-tag-phi-state,1) && t1(interned-tag-phi-state, phi-state);
      else if not tt.is-t(interned-tag-phi-state,1)
      then tt = tt && t1(interned-tag-phi-state, phi-state);
   };
   tt
);

