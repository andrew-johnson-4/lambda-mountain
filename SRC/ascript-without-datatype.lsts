
let .without-datatype(tt: Type): Type = (
   match tt {
      TAnd{ conjugate=conjugate } => (
         let result = ta;
         for c in conjugate { if not(non-zero(result)) then result = c.without-datatype };
         result;
      );
      TGround{ tag=tag, parameters=parameters } => (
         if tt.is-datatype then ta else tt
      );
      _ => ta;
   }
);
