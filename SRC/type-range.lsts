
let .range(tt: Type): Type = (
   match tt {
      TAnd { conjugate=conjugate } => (
         let result = ta;
         for c in conjugate { result = result || c.range };
         result
      );
      TGround { tag:interned-tag-arrow, parameters:[rng.. dom..] } => rng;
      TGround { tag:interned-tag-array, parameters:[_.. array-base..] } => array-base.range;
      _ => ta;
   }
);
