
let global-tctx = {} : Hashtable<CString,Vector<TypeContextRow>>;
let tctx-currently-processing-globals = true;

type TypeContextRow zero NullTypeContextRow implies MustRetain, MustRelease = NullTypeContextRow | TypeContextRow { key: CString, nt: Type, dt: Type, blame: AST };
type PhiContextRow zero NullPhiContextRow implies MustRetain, MustRelease = NullPhiContextRow | PhiContextRow { phi-id: U32, phi-tt: Type, blame: AST, dead-on-arrival: Bool, is-global: Bool };
type TypeContext implies MustRetain, MustRelease = { tctx:List<TypeContextRow>, pctx: PBTree<U32,PhiContextRow>, is-unsafe: Bool, is-blob: Bool, function-name:CString };
let .into(pr: PhiContextRow, tt: Type<String>): String = "#\{pr.phi-id-or-zero} : \{pr.phi-tt-or-zero}";
let .function-name(tctx: TypeContext?): CString = tctx.get-or(mk-tctx()).function-name;

let mk-tctx(): TypeContext = TypeContext( [] : List<TypeContextRow>, mk-pbtree(type(U32), type(PhiContextRow)), false, false, c"" );

let .key-or-zero(tr: TypeContextRow): CString = (
   match tr {
      TypeContextRow{ key=key } => key;
      _ => c"";
   }
);
let .nt-or-zero(tr: TypeContextRow): Type = (
   match tr {
      TypeContextRow{ nt=nt } => nt;
      _ => ta;
   }
);
let .dt-or-zero(tr: TypeContextRow): Type = (
   match tr {
      TypeContextRow{ dt=dt } => dt;
      _ => ta;
   }
);
let .dt-or-zero(tr: TypeContextRow?): Type = (
   if not non-zero(tr) then ta
   else match tr.get-or-panic {
      TypeContextRow{ dt=dt } => dt;
      _ => ta;
   }
);
let .direct-type(tr: TypeContextRow): Type = (
   match tr {
      TypeContextRow{ nt=nt, dt=dt } => if non-zero(nt) then nt else dt;
      _ => ta;
   }
);
let .blame-or-zero(tr: TypeContextRow): AST = (
   match tr {
      TypeContextRow{ blame=blame } => blame;
      _ => ASTEOF;
   }
);

let .phi-id-or-zero(tr: PhiContextRow): U32 = (
   match tr {
      PhiContextRow{ phi-id=phi-id } => phi-id;
      _ => 0;
   }
);
let .phi-tt-or-zero(tr: PhiContextRow): Type = (
   match tr {
      PhiContextRow{ phi-tt=phi-tt } => phi-tt;
      _ => ta;
   }
);
let .blame-or-zero(tr: PhiContextRow): AST = (
   match tr {
      PhiContextRow{ blame=blame } => blame;
      _ => ASTEOF;
   }
);
let .dead-on-arrival-or-zero(tr: PhiContextRow): Bool = (
   match tr {
      PhiContextRow{ dead-on-arrival=dead-on-arrival } => dead-on-arrival;
      _ => false;
   }
);
let .is-global-or-zero(tr: PhiContextRow): Bool = (
   match tr {
      PhiContextRow{ is-global=is-global } => is-global;
      _ => false;
   }
);

let .with-phi-tt(tr: PhiContextRow, phi-tt: Type): PhiContextRow = (
   match tr {
      PhiContextRow{ phi-id=phi-id, blame=blame, dead-on-arrival=dead-on-arrival, is-global=is-global } => PhiContextRow(phi-id, phi-tt, blame, dead-on-arrival, is-global);
      _ => tr;
   }
);
