
let .with-only-tag(tt: Type): Type = (
   match tt {
      TAnd{ conjugate=conjugate } => (
         let result = ta;
         for c in conjugate { if not(non-zero(result)) then result = c.with-only-tag };
         result;
      );
      TGround{ tag:interned-tag-tag } => tt;
      _ => ta;
   }
);
