
let .is-parameterized(tt: Type): Bool = (
   match tt {
      TAny {} => false;
      TVar {} => true;
      TAnd { conjugate=conjugate } => (
         let result = false;
         for c in conjugate { result = result or c.is-open };
         result
      );
      TGround { tag:interned-tag-array, parameters:[_.. TAny{}..] } => false;
      TGround { tag:interned-tag-array, parameters:[_.. base-type..] } => base-type.is-open;
      TGround { parameters=parameters } => (
         let is-open = false;
         for p in parameters { is-open = is-open or p.is-open; };
         is-open;
      );
      TId{} => false;
   }
);
