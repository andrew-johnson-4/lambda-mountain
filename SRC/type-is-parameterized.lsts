
let .is-parameterized(tt: Type): Bool = (
   match tt {
      TAny {} => false;
      TVar {} => true;
      TAnd { conjugate=conjugate } => (
         let result = false;
         for c in conjugate { result = result or c.is-parameterized };
         result
      );
      TGround { tag:interned-tag-array, parameters:[_.. TAny{}..] } => false;
      TGround { tag:interned-tag-array, parameters:[_.. base-type..] } => base-type.is-parameterized;
      TGround { parameters=parameters } => (
         let is-parameterized = false;
         for p in parameters { is-parameterized = is-parameterized or p.is-parameterized; };
         is-parameterized;
      );
      TId{} => false;
   }
);
