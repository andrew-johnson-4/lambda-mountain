
let codegen-defined-type-index = mk-set(type(Type));

let define-codegen(tt: Type) = codegen-defined-type-index = codegen-defined-type-index.bind(tt);

let .is-codegen-defined(tt: Type): Bool = (
   tt.is-codegen-defined(tt.is-t(interned-tag-flexible-array-member,0));
);

let .is-codegen-defined(tt: Type, is-flexible-array-member: Bool): Bool = (
   match tt {
      TAnd{conjugate=conjugate} => (
         let r = false;
         for c in conjugate { r = r or c.is-codegen-defined(is-flexible-array-member) };
         r
      );
      TAny{} => false;
      TVar{} => false;
      TGround{tag:interned-tag-sized,parameters:[st..]} => st.is-codegen-defined;
      TGround{tag:interned-tag-array,parameters:[_..base-type..]} => is-flexible-array-member and base-type.is-codegen-defined;
      TGround{} => complex-type-index.has(tt.ground-tag-and-arity)
                and not codegen-defined-type-index.lookup(tt, false);
   }
);

let find-concrete-types(t: AST): Vector<(Type,Type)> = (
   let vs = mk-vector(type((Type,Type)));
   match t {
      Seq{seq=seq} => (
         for s in seq {
            for tt in find-concrete-types(s) {
               vs = vs.push(tt);
            };
         };
      );
      Typedef{lhs-type=lhs-type} => (
         for concrete-type in concrete-type-instances-index.lookup(lhs.ground-tag-and-arity, mk-vector(type(Type))) {
            vs = vs.push((lhs-type, concrete-type));
         }
      );
      _ => ();
   };
   vs
);

let render-forward-type-declaration(t: AST): Vector<Type> = (
   let ts = find-concrete-types(t);

   for Tuple{lhs-type=first, concrete-type=second} in ts {
      print("Render forward type declaration \{lhs-type} \{concrete-type}\n");
   };
);

