
let phi-as-state(tt: Type): Type = (
   match tt {
      TAnd{conjugate=conjugate} => (
         let new-conjugate = mk-vector(type(Type));
         for c in conjugate {
            new-conjugate = new-conjugate.push(phi-as-state(c));
         };
         tand(new-conjugate);
      );
      TGround{tag:interned-tag-cons,parameters:[t1..t0..]} => t2(interned-tag-cons,t0,t1);
      TGround{} => if tt.is-phi-type then t1(interned-tag-phi-state,tt) else tt;
      _ => tt;
   }
);
