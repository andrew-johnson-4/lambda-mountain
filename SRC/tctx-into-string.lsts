
let .into(tree: PBTree<U64,PhiContextRow>, tt: Type<String>): String = (
   match tree {
      PBLeaf {} => "";
      PBNode1 { k11=k1, v11=v1, left=left, right=right } => (
         left.into(type(String)) +
         "\{k11} : \{v11.phi-tt-or-zero}\n" +
         right.into(type(String))
      );
      PBNode2 { k12=k1, v12=v1, k22=k2, v22=v2, left=left, mid=mid, right=right } => (
         left.into(type(String)) +
         "\{k12} : \{v12.phi-tt-or-zero}\n" +
         mid.into(type(String)) +
         "\{k22} : \{v22.phi-tt-or-zero}\n" +
         right.into(type(String))
      );
   }
);

let .into(tctx: Maybe<TypeContext>, tt: Type<String>): String = (
   let result = "";
   for tr in tctx.get-or(mk-tctx()).tctx {
      result = result + "\{tr.key-or-zero} : \{tr.direct-type}\n";
   };
   result = result + tctx.get-or(mk-tctx()).pctx.into(type(String));
   result
);
