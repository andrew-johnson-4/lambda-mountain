
let std-apply-macro-candidates(tctx: TypeContext?, mname: CString, margs: AST, candidates: List<(Type,AST)>): (TypeContext?, AST, Type) = (
   # candidates must be in last-most-first order
   # Example: Source Definitions
   # define macro candidate 1
   # define macro candidate 2
   # should be sent as
   # [ candidate 2, candidate 1 ]
   let t = mk-eof();
   let return-type = ta;
   for Tuple{ctype=first, second:Abs{mlhs=lhs,rhs:App{left:Lit{key:c":"},right:App{mrhs=left,right:AType{new-return-type=tt}}}}} in candidates {
      if not(non-zero(t)) {
         (let new-tctx, let mctx) = std-try-destructure-macro(tctx, margs, ctype, mlhs);
         tctx = tctx.phi-append(new-tctx);
         if mctx.is-some then mctx = union(mctx, Some(extract-uuids(mrhs)));
         if mctx.is-some then return-type = new-return-type;
         if mctx.is-some then t = substitute(mctx.get-or-panic, mrhs).with-location-preserve(margs.location);
      }
   };
   (tctx, t, return-type)
);

let std-macro-unpack-args(actx: AContext?, parameters: Vector<Type>, margs: AST): AContext? = (
   Some([] : AContext)
);

let std-try-destructure-macro(tctx: TypeContext?, margs: AST, mtype: Type, mcandidate: AST): (TypeContext?, AContext?) = (
   let no = (None : AContext?)();
   let yes = Some([] : AContext);
   if let Abs{lhs=lhs, rhs=rhs} = mcandidate then std-try-destructure-macro(tctx, margs, mtype, lhs)
   else {
      match mtype {
         TGround{tag:interned-tag-cons, parameters:[p2.. p1..]} => (
            match margs {
               App{left=left, right=right} => (
                  match mcandidate {
                     App{cleft=left, cright=right} => (
                        (tctx, let mctx1) = std-try-destructure-macro(tctx, left, p1, cleft);
                        (tctx, let mctx2) = std-try-destructure-macro(tctx, right, p2, cright);
                        (tctx, union(mctx1, mctx2))
                     );
                     _ => (tctx, no);
                  }
               );
               _ => (tctx, no);
            }
         );
         TVar{name:c"macro::constant"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname1=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-constant(tctx, c"macro::constant", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname1, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::variable"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname2=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-variable(tctx, c"macro::variable", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname2, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::underscore"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname3=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-underscore(tctx, c"macro::underscore", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname3, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::nil"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname4=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-nil(tctx, c"macro::nil", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname4, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::nil"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname5=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-nil(tctx, c"macro::ast::nil", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname5, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::as"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{
                  left:App{ left:Var{vname21=key}, right:Var{vname22=key} },
                  right:AType{tt=tt}
               } } => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-as(tctx, c"macro::ast::as", margs);
                  match new-term {
                     App{ base-term=left, base-type=right } => (
                        (new-tctx, yes.bind(vname21,base-term).bind(vname22,base-type))
                     );
                     _ => (tctx, no);
                  }
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::if"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{
                  left:App{
                     left:App{ left:Var{vname23=key}, right:Var{vname24=key} },
                     right:Var{vname25=key}
                  },
                  right:AType{tt=tt}
               } } => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-if(tctx, c"macro::ast::if", margs);
                  match new-term {
                     App{ left:App{ base-cond=left, base-tterm=right }, base-fterm=right } => (
                        (new-tctx, yes.bind(vname23,base-cond).bind(vname24,base-tterm).bind(vname25,base-fterm))
                     );
                     _ => (tctx, no);
                  }
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::let"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{
                  left:App{ left:Var{vname26=key}, right:Var{vname27=key} },
                  right:AType{tt=tt}
               } } => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-let(tctx, c"macro::ast::let", margs);
                  match new-term {
                     App{ let-lhs=left, let-rhs=right } => (
                        (new-tctx, yes.bind(vname26,let-lhs).bind(vname27,let-rhs))
                     );
                     _ => (tctx, no);
                  }
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::eof"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname6=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-eof(tctx, c"macro::ast::eof", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname6, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::var"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname7=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-var(tctx, c"macro::ast::var", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname7, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::lit"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname8=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-lit(tctx, c"macro::ast::lit", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname8, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::meta"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname9=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-meta(tctx, c"macro::ast::meta", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname9, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::app"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname10=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-app(tctx, c"macro::ast::app", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname10, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::fragment"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname11=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-fragment(tctx, c"macro::ast::fragment", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname11, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::typedef"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname12=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-typedef(tctx, c"macro::ast::typedef", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname12, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::type"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname13=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-type(tctx, c"macro::ast::type", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname13, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::glb"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname14=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-glb(tctx, c"macro::ast::glb", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname14, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::seq"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname15=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-seq(tctx, c"macro::ast::seq", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname15, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::ast::sizeof"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname16=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-ast-sizeof(tctx, c"macro::ast::sizeof", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname16, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         _ => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{mstruct=left, right:AType{tt:TVar{name:c"macro::literal",parameters:[TGround{literal-tag=tag,parameters=parameters}.. etc-parameters]}}}} => (
                  match margs {
                     App{left:Lit{key:c":"}, right:App{left:Lit{key1=key}, right:AType{tt=tt}}} => (tctx, if key1==untern(literal-tag) and parameters.length==0 then yes else no);
                     Lit{key2=key} => (tctx, if key2==untern(literal-tag) and parameters.length==0 then yes else no);
                     App{ left:App{left:Lit{key:c":"}, right:App{left:Lit{key3=key}, right:AType{tt=tt}}}, margs-right=right } => (tctx, if key3==untern(literal-tag) then std-macro-unpack-args(yes,parameters,margs-right) else no);
                     App{ left:Lit{key4=key}, margs-right=right } => (tctx, if key4==untern(literal-tag) then std-macro-unpack-args(yes,parameters,margs-right) else no);
                     _ => (tctx, no);
                  };
               );
               App{left:Lit{key:c":"}, right:App{mstruct=left, right:AType{tt=tt}}} => (
                  if non-zero(std-macro-helper-name(tt))
                  then {
                     let macro-helper = std-macro-helper-name(tt);
                     match margs {
                        App{left:Var{maybe-helper=key}, helper-args=right} => (
                           if macro-helper==maybe-helper {
                              # infallible, like matching macro::a(x) against macro::a
                              (let new-tctx, let helped) = std-apply-macro-helper(tctx, macro-helper, helper-args, Used());
                              if non-zero(helped)
                              then (new-tctx, std-direct-destructure-macro(helped, mstruct, macro-helper, mstruct, margs))
                              else (tctx, no)
                           } else (tctx, no)
                        );
                        _ => (
                           if index-macro-meta.has-key(macro-helper) {
                              # fallible, like matching x against macro::variable or macro::nil
                              (let new-tctx, let helped) = std-apply-macro-weak(tctx, macro-helper, margs, Used());
                              if non-zero(helped)
                              then (new-tctx, std-direct-destructure-macro(helped, mstruct, macro-helper, mstruct, margs))
                              else (tctx, no)
                           } else (tctx, no)
                        );
                     };
                  } else (tctx, std-direct-destructure-macro(margs, mstruct, c"[direct]", mstruct, margs))
               );
               _ => (tctx, no);
            }
         );
      }
   };
);

let std-macro-helper-name(tt: Type): CString = (
   match tt {
      TVar{name1=name} => if name1.has-prefix(c"macro::") then name1 else c"";
      TAnd{conjugate=conjugate} => (
         let name2 = c"";
         for c in conjugate {
            if not(non-zero(name2)) then name2 = std-macro-helper-name(c);
         };
         name2
      );
      _ => c"";
   };
);
