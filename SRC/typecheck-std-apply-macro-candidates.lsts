
let std-apply-macro-candidates(tctx: TypeContext?, mname: CString, margs: AST, candidates: List<(Type,AST)>): (TypeContext?, AST, Type) = (
   # candidates must be in last-most-first order
   # Example: Source Definitions
   # define macro candidate 1
   # define macro candidate 2
   # should be sent as
   # [ candidate 2, candidate 1 ]
   let t = mk-eof();
   let return-type = ta;
   for Tuple{ctype=first, second:Abs{mlhs=lhs,rhs:App{left:Lit{key:c":"},right:App{mrhs=left,right:AType{new-return-type=tt}}}}} in candidates {
      if not(non-zero(t)) {
         (let new-tctx, let mctx) = std-try-destructure-macro(tctx, margs, ctype, mlhs);
         tctx = tctx.phi-append(new-tctx);
         if mctx.is-some then mctx = union(mctx, Some(extract-uuids(mrhs)));
         if mctx.is-some then return-type = new-return-type;
         if mctx.is-some then t = substitute(mctx.get-or-panic, mrhs).with-location-preserve(margs.location);
      }
   };
   (tctx, t, return-type)
);

let std-macro-unpack-args(actx: AContext?, parameters: Vector<Type>, margs: AST): AContext? = (
   Some([] : AContext)
);

let std-try-destructure-macro(tctx: TypeContext?, margs: AST, mtype: Type, mcandidate: AST): (TypeContext?, AContext?) = (
   print("Try destructure margs \{margs}\n");
   print("Try destructure mtype \{mtype}\n");
   print("Try destructure mcandidate \{mcandidate}\n");
   let no = (None : AContext?)();
   let yes = Some([] : AContext);
   if let Abs{lhs=lhs, rhs=rhs} = mcandidate then std-try-destructure-macro(tctx, margs, mtype, lhs)
   else {
      match mtype {
         TGround{tag:interned-tag-cons, parameters:[p2.. p1..]} => (
            match margs {
               App{left=left, right=right} => (
                  match mcandidate {
                     App{cleft=left, cright=right} => (
                        (tctx, let mctx1) = std-try-destructure-macro(tctx, left, p1, cleft);
                        (tctx, let mctx2) = std-try-destructure-macro(tctx, right, p2, cright);
                        (tctx, union(mctx1, mctx2))
                     );
                     _ => (tctx, no);
                  }
               );
               _ => (tctx, no);
            }
         );
         TVar{name:c"macro::constant"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname1=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-constant(tctx, c"macro::constant", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname1, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::variable"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname2=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-variable(tctx, c"macro::variable", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname2, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::underscore"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname3=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-underscore(tctx, c"macro::underscore", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname3, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         TVar{name:c"macro::nil"} => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{left:Var{vname4=key}, right:AType{tt=tt}}} => (
                  (let new-tctx, let new-term) = std-apply-macro-nil(tctx, c"macro::nil", margs);
                  if non-zero(new-term)
                  then (new-tctx, yes.bind(vname4, new-term))
                  else (tctx, no)
               );
               _ => (tctx, no);
            };
         );
         _ => (
            match mcandidate {
               App{left:Lit{key:c":"}, right:App{mstruct=left, right:AType{tt:TVar{name:c"macro::literal",parameters:[TGround{literal-tag=tag,parameters=parameters}.. etc-parameters]}}}} => (
                  match margs {
                     App{left:Lit{key:c":"}, right:App{left:Lit{key1=key}, right:AType{tt=tt}}} => (tctx, if key1==untern(literal-tag) and parameters.length==0 then yes else no);
                     Lit{key2=key} => (tctx, if key2==untern(literal-tag) and parameters.length==0 then yes else no);
                     App{ left:App{left:Lit{key:c":"}, right:App{left:Lit{key3=key}, right:AType{tt=tt}}}, margs-right=right } => (tctx, if key3==untern(literal-tag) then std-macro-unpack-args(yes,parameters,margs-right) else no);
                     App{ left:Lit{key4=key}, margs-right=right } => (tctx, if key4==untern(literal-tag) then std-macro-unpack-args(yes,parameters,margs-right) else no);
                     _ => (tctx, no);
                  };
               );
               App{left:Lit{key:c":"}, right:App{mstruct=left, right:AType{tt=tt}}} => (
                  if non-zero(std-macro-helper-name(tt))
                  then {
                     let macro-helper = std-macro-helper-name(tt);
                     match margs {
                        App{left:Var{maybe-helper=key}, helper-args=right} => (
                           if macro-helper==maybe-helper {
                              # infallible, like matching macro::a(x) against macro::a
                              (let new-tctx, let helped) = std-apply-macro-helper(tctx, macro-helper, helper-args, Used());
                              if non-zero(helped)
                              then (new-tctx, std-direct-destructure-macro(helped, mstruct, macro-helper, mstruct, margs))
                              else (tctx, no)
                           } else (tctx, no)
                        );
                        _ => (
                           if index-macro-meta.has-key(macro-helper) {
                              # fallible, like matching x against macro::variable or macro::nil
                              (let new-tctx, let helped) = std-apply-macro-weak(tctx, macro-helper, margs, Used());
                              if non-zero(helped)
                              then (new-tctx, std-direct-destructure-macro(helped, mstruct, macro-helper, mstruct, margs))
                              else (tctx, no)
                           } else (tctx, no)
                        );
                     };
                  } else (tctx, std-direct-destructure-macro(margs, mstruct, c"[direct]", mstruct, margs))
               );
               _ => (tctx, no);
            }
         );
      }
   };
);

let std-macro-helper-name(tt: Type): CString = (
   match tt {
      TVar{name1=name} => if name1.has-prefix(c"macro::") then name1 else c"";
      TAnd{conjugate=conjugate} => (
         let name2 = c"";
         for c in conjugate {
            if not(non-zero(name2)) then name2 = std-macro-helper-name(c);
         };
         name2
      );
      _ => c"";
   };
);
