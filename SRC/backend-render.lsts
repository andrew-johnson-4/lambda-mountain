
let .frame(f: Hashtable<CString,S>): S = f.lookup(c"frame", SNil);
let .expression(f: Hashtable<CString,S>): S = f.lookup(c"expression", SNil);

let .set(f: Hashtable<CString,S>, key: CString, val: S): Hashtable<CString,S> = f.bind(key,val);
let .set(f: Hashtable<CString,S>, key: CString, val: String): Hashtable<CString,S> = f.bind(key,SAtom(val));
let .get(f: Hashtable<CString,S>, key: CString): S = f.lookup(key,SNil);

let mk-io-fragment(): Hashtable<CString,S> = mk-hashtable(type(CString), type(S));
let mk-io-expression(s: S): Hashtable<CString,S> = mk-hashtable(type(CString), type(S)).bind(c"expression", s);
let mk-io-expression(s: String): Hashtable<CString,S> = mk-hashtable(type(CString), type(S)).bind(c"expression", SAtom(s));

let render-plugin(): Nil = (
   write-file(config-target, render().into(type(CString)));
);

let global-identifier-namespace-defined = mk-hashtable(type(String), type(String));

let global-declaration-initializers = SNil;

let render(): String = (
   render-includes(ast-parsed-program) +
   render-forward-type-declaration(ast-parsed-program) +
   render-direct-type-declaration(ast-parsed-program) +
   render-forward-function-declaration(ast-parsed-program) +
   render-global-declaration(ast-parsed-program) +
   render-direct-function-declaration(ast-parsed-program)
);

let render-includes(t: AST): String = (
   let result = match t {
      Seq{seq=seq} => (
         let decls = "";
         for s in seq {
            decls = decls + render-includes(s);
         };
         decls
      );
      App{ left:Var{key:c"import"}, right:App{ left:Lit{key:c":"}, right:App{ left:Lit{fp=key}, right:AType{} } } } => (
         if fp.has-suffix(c".h") or fp.has-suffix(c".c")
         then "#include <\{fp}>\n";
         else "";
      );
      _ => "";
   };
   result
);

let render-forward-function-declaration(t: AST): String = (
   let result = match t {
      Seq{seq=seq} => (
         let decls = "";
         for s in seq {
            decls = decls + render-forward-function-declaration(s);
         };
         decls
      );
      Glb{key=key, f=val:Abs{lhs=lhs, rhs=rhs, tt=tt}} => (
         if not tt.is-t(interned-tag-cffi,0) and
            not tt.is-t(interned-tag-blob,0) and
            not tt.is-t(interned-tag-typed-macro,0) and
            not typeof-term(f).is-open {
            let def = "\{render(typeof-term(f).range)} \{render-identifier(key.key, typeof-term(f))}(\{render-function-parameters(lhs)});\n";
            global-identifier-namespace-defined = global-identifier-namespace-defined.bind( "\{render-identifier(key.key, typeof-term(f))}", def );
            def
         } else ""
      );
      _ => "";
   };
   result
);

let render-direct-function-declaration(t: AST): String = (
   let result = match t {
      Seq{seq=seq} => (
         let global-frames = SNil;
         let global-expressions = SNil;
         let global-functions = SNil;
         let main-function = mk-eof();
         for s in seq {
            match s {
               Glb{key:Token{key:c"main"}} => main-function = s;
               Glb{val:Abs{}} => global-functions = global-functions + render-direct-function-declaration(s);
               _ => (
                  let e = render(s);
                  if non-zero(e) and non-zero(e.frame) then global-frames = global-frames + e.frame + ";";
                  if non-zero(e) and non-zero(e.expression) then global-expressions = global-expressions + e.expression + ";";
               );
            };
         };
         (global-functions + render-direct-function-declaration(global-frames + global-expressions, main-function)).into(type(String));
      );
      Glb{val:Abs{tt=tt}} => render-direct-function-declaration(SNil, t);
      _ => (
         let rt = render-statement(t);
         let result = render-direct-function-declaration(rt.frame + rt.expression, mk-eof());
         result
      );
   };
   result
);

let render-direct-function-declaration(exprs: S, t: AST): String = (
   let result = match t {
      Glb{key=key, f=val:Abs{lhs=lhs, rhs=rhs, tt=tt}} => (
         if not tt.is-t(interned-tag-blob,0) and
            not tt.is-t(interned-tag-typed-macro,0) and
            not tt.is-t(interned-tag-cffi,0) and
            not typeof-term(f).is-open
         then (
            let rt = render-return(rhs);
            if key.key == c"main"
            then "\{render(typeof-term(f).range)} \{render-identifier(key.key, typeof-term(f))}(\{render-function-parameters(lhs)}){\{global-declaration-initializers}\{exprs}\{rt.frame}\{rt.expression}}\n"
            else "\{render(typeof-term(f).range)} \{render-identifier(key.key, typeof-term(f))}(\{render-function-parameters(lhs)}){\{exprs}\{rt.frame}\{rt.expression}}\n"
         ) else ""
      );
      ASTEOF{} => "int main(){\{global-declaration-initializers}\{exprs}}\n";
      _ => "";
   };
   result
);

let render-function-parameters(lhs: AST): String = (
   let result = match lhs {
      App{ rst=left, bind=right:App{ left:Lit{key:c":"}, right:App{ left:Var{}, right:AType{} } } } => (
         let m = render-function-parameters(rst);
         let n = render-function-parameters(bind);
         if non-zero(m) and non-zero(n)
         then "\{m},\{n}"
         else "\{m}\{n}";
      );
      App{ left:Lit{key:c":"}, right:App{ vbind=left:Var{vid=key}, right:AType{vtt=tt} } } => (
         let rt = render(vtt);
         global-identifier-namespace-defined = global-identifier-namespace-defined.bind( render-identifier(vid,vtt), "\{rt} \{render-identifier(vid,vtt)}" );
         if non-zero(rt)
         then "\{rt} \{render-identifier(vid,vtt)}"
         else "";
      );
      ASTNil{} => "";
      _ => fail("Render unknown function parameters \{lhs}\n");
   };
   result
);

let render-return(t: AST): Hashtable<CString,S> = (
   let result = match t {
      App{ left:Lit{key:c":"}, right:App{ inner=left, right:AType{} } } => render-return(inner);
      App{is-cons=is-cons, left=left, right=right} => (
         if is-cons
         then (
            let lt = render-statement(left);
            let rt = render-statement(right);
            if non-zero(rt) then (lt + rt).set(c"expression", "\{lt.expression}return \{rt.expression}")
            else (lt + rt).set(c"expression", "\{lt.expression}\{rt.expression}")
         ) else render-statement(t);
      );
      _ => (
         let rt = render-statement(t);
         if non-zero(rt) and not typeof-term(t).is-t(interned-tag-nil,0)
         then rt.set(c"expression", "return \{rt.expression}");
         else rt
      );
   };
   result
);

let render-statement(t: AST): Hashtable<CString,S> = (
   match t {
      App{ left:Lit{key:c":"}, right:App{ inner=left, right:AType{} } } => render-statement(inner);
      App{is-cons=is-cons, left=left, right=right} => (
         if is-cons
         then render-statement(left) + render-statement(right)
         else (
            let rt = render(t);
            rt.set(c"expression", if non-zero(rt.expression) then "\{rt.expression};" else "");
         );
      );
      _ => (
         let rt = render(t);
         rt.set(c"expression", if non-zero(rt.expression) then "\{rt.expression};" else "");
      );
   };
);

let render-global-declaration(t: AST): String = (
   let result = match t {
      Seq{seq=seq} => (
         let result = "";
         for s in seq {
            result = result + render-global-declaration(s);
         };
         result;
      );
      Glb{key=key, val=val} => (
         match val {
            Abs{} => "";
            _ => (
               let gtt = typeof-term(val);
               let vtt = gtt.datatype;
               let def = if gtt.is-t(interned-tag-cffi,0)
               then ""
               else render-global-declaration(key.key.into(type(String)), vtt, val);
               count-global-namespace(key.key.into(type(String)), def);
               def
            );
         }
      );
      _ => "";
   };
   result
);

let render-declaration(k: String, kt: Type, t: AST): String = (
   (let prefix, let suffix) = render-declaration(kt);
   let rt = render(t);
   "\{prefix} \{render-identifier(k,kt)}\{suffix};\n";
);

let render-global-declaration(k: String, kt: Type, t: AST): String = (
   (let prefix, let suffix) = render-declaration(kt);
   let rt = render(t);
   let result = "\{prefix} \{render-identifier(k,kt)}\{suffix};\n";
   if not t.is-nil-constant {
      global-declaration-initializers = global-declaration-initializers +
      "\{render-identifier(k,kt)} = \{rt.expression};\n"
   };
   result
);

let render-declaration(tt: Type): (String, String) = (
   let is-flexible-array-member = tt.is-t(interned-tag-flexible-array-member,0);
   tt = tt.normalize.rewrite-opaque-type-alias.without-any-phi;
   let result = render-declaration(tt, is-flexible-array-member);
   result
);

let render-declaration(tt: Type, is-flexible-array-member: Bool): (String, String) = (
   let result = match tt {
      TGround{tag:interned-tag-array, parameters:[ TGround{tag:interned-tag-CONST}.. array-base.. ]} => (
         (let prefix, let suffix) = render-declaration(array-base, false);
         ( prefix, "\{suffix}[]" )
      );
      TGround{tag:interned-tag-array, parameters:[ TGround{tag:interned-tag-c,parameters:[TGround{width1=tag}..]}.. array-base.. ]} => (
         (let prefix, let suffix) = render-declaration(array-base, false);
         ( prefix, "\{suffix}[\{untern(width1)}]" )
      );
      TGround{tag:interned-tag-array, parameters:[ TGround{width2=tag}.. array-base.. ]} => (
         (let prefix, let suffix) = render-declaration(array-base, false);
         ( prefix, "\{suffix}[\{untern(width2)}]" )
      );
      TGround{tag:interned-tag-array, parameters:[ TAny{}.. array-base.. ]} => (
         if is-flexible-array-member {
            (let prefix, let suffix) = render-declaration(array-base, false);
            ( prefix, "\{suffix}[]" )
         } else {
            (render(array-base) + "*", "")
         }
      );
      TGround{tag:interned-tag-arrow, parameters:[ rng.. dom.. ]} => (
         ("(*\{render(rng)})(", "\{render(dom)})")
      );
      _ => (render(tt), "");
   };
   result
);

let count-global-namespace(k: String, v: String): Nil = (
   global-identifier-namespace-defined = global-identifier-namespace-defined.bind( k, v );
);

let render(t: AST): Hashtable<CString,S> = (
   let result = match t {
      Seq{seq=seq} => (
         let result = mk-io-fragment();
         for s in seq {
            s = mk-app( mk-var(c"macro::backend::render"), s );
            (global-flow-tctx, s) = std-infer-expr(global-flow-tctx, s, false, Used, ta);
            result = result + render(s);
         };
         result;
      );
      App{ left:Var{key:c"mangle"}, right:App{ left:Var{vk=key}, right:AType{tt=tt} } } => (
         mk-io-expression(render-identifier(vk, tt.l1))
      );
      App{ left:Var{key:c"mangle"}, right:App{ left:App{ left:Lit{key:c":"}, right:App{ left:Var{vk=key}, right:AType{} } }, right:AType{tt=tt} } } => (
         mk-io-expression(render-identifier(vk, tt.l1))
      );
      App{ left:Var{key:c"mangle-pre"}, right:AType{tt=tt} } => (
         mk-io-expression(render-declaration(tt.l1).first)
      );
      App{ left:Var{key:c"mangle-post"}, right:AType{tt=tt} } => (
         mk-io-expression(render-declaration(tt.l1).second)
      );
      App{asc=left:Var{key:c"as"}, right:App{it=left,ot=right:AType{tt=tt}}} => (
         let f = render(it);
         let itt = typeof-term(it);
         if not itt.is-t(interned-tag-l,0) and tt.is-datatype
         then f = f.set(c"expression", "((\{render(tt)})(\{f.expression}))");
         f
      );
      App{ left:Var{key:c"scope"}, st=right } => render(st);
      App{ left:Var{key:c"sizeof"}, right:AType{tt=tt} } => mk-io-expression("(sizeof(\{render(tt)}))");
      App{ left:Abs{lhs:Var{lname=key}, rhs:ASTNil{}}, rhs=right } => (
         let vtt = typeof-term(rhs).datatype;
         let decl = render-declaration(lname.into(type(String)), vtt, rhs);
         count-global-namespace( render-identifier(lname,vtt), decl );
         mk-io-expression(decl);
      );
      App{left:App{ left:App{ ifv=left:Var{key:c"if"}, cond=right }, tterm=right }, fterm=right} => (
         let cf = render(cond);
         let tf = render(tterm);
         let ff = render(fterm);
         let f = cf + tf + ff;
         f.set(c"expression", "((\{cf.expression})?(\{tf.expression}):(\{ff.expression}))");
      );
      App{ left:Lit{key:c":"}, right:App{ left:Lit{cv=key}, right:AType{tt=tt} } } => (
         if tt <: type-cstring-literal or
            tt <: type-char-array-literal 
         then mk-io-expression(render-cstring(cv))
         else mk-io-expression(cv.into(type(String)))
      );
      App{ left:Lit{key:c":"}, right:App{ inner=left, right:AType{} } } => render(inner);
      App{ left:Var{key:c":"}, right:App{ inner=left, right:AType{} } } => render(inner);
      App{ left:Var{key:c"import"}, right:App{ left:Lit{key:c":"}, right:App{ left:Lit{}, right:AType{} } } } => mk-io-fragment();
      App{left=left, right=right} => (
         let lt = render(left);
         let rt = render(right);
         let tr = Some(mk-tctx()).find-callable(var-name-if-var-or-lit(left), typeof-term(right), t, typeof-term(t), false);
         let fnc = typeof-term(left);
         if non-zero(tr) and tr.get-or-panic.dt-or-zero.is-t(interned-tag-blob,0) {
            let fterm = tr.get-or-panic.blame-or-zero;
            let tctx = Some(mk-tctx()).apply-lhs(fterm.domain, right);
            match tctx.beta-substitute(fterm.range) {
               App{ left:Lit{key:c":"}, right:App{ f=left:Fragment{}, right:AType{} } } => render(f);
               f => render(f);
            };
         } else if var-name-if-var-or-lit(left).has-prefix(c"..") {
            mk-io-expression(rt.get(tail(tail(var-name-if-var-or-lit(left)))))
         } else if typeof-term(t).is-t(interned-tag-cons,2)
         then (
            if typeof-term(right).is-datatype and typeof-term(left).is-datatype-or-cons-datatype
            then (lt + rt).set(c"expression", "\{lt.expression},\{rt.expression}")
            else if not non-zero(lt.expression) or not non-zero(rt.expression) or not typeof-term(left).is-datatype or not typeof-term(right).is-datatype
            then (lt + rt).set(c"expression", "\{lt.expression}\{rt.expression}")
            else (lt + rt).set(c"expression", "({\{lt.expression};\{rt.expression};})")
         ) else if typeof-term(left).is-t(interned-tag-arrow,2)
           then (lt + rt).set(c"expression", "\{lt.expression}(\{rt.expression})")
           else if not non-zero(lt.expression) or not non-zero(rt.expression) or not typeof-term(left).is-datatype or not typeof-term(right).is-datatype
           then (lt + rt).set(c"expression", "\{lt.expression}\{rt.expression}")
           else (lt + rt).set(c"expression", "({\{lt.expression};\{rt.expression};})")
      );
      Fragment{kvs=kvs} => (
         let f = mk-io-fragment();
         for Tuple{fk=first, fv=second} in kvs.as-vector {
            f = f.set(fk, render(fv).expression);
         };
         f
      );
      ASTNil{} => mk-io-expression("({})");
      ASTEOF{} => mk-io-fragment();
      Lit{key1=key} => mk-io-expression(key1.into(type(String)));
      Var{key2=key} => (
         let ftt = typeof-term(t);
         let vtt = ftt.datatype;
         let m = if ftt.is-t(interned-tag-cffi,0) then key2.into(type(String)) else render-identifier(key2, vtt);
         # TODO: determine if this is a C global and passthrough, otherwise LM convention
         mk-io-expression(m);
      );
      #AType{tt:TGround{tag:interned-tag-type,parameters:[p1..]}} => render(p1);
      AType{tt=tt} => mk-io-expression(render(tt));
      Glb{} => mk-io-fragment();
      Typedef{} => mk-io-fragment();
      #_ => fail("render unknown term \{t}");
   };
   print("Render \{t}\n");
   print("Render result frame \{result.frame}\n");
   print("Render result expression \{result.expression}\n");
   result
);

let render-identifier(k: CString): String = (
   let result = render-identifier(k.into(type(String)));
   result
);

let render-identifier(k: String): String = (
   let cs = mk-vector(type(U8));
   let ci = 0_sz;
   while ci < k.length { match k[ci] {
      33 => cs = cs.push(c"_EX_"); # !
      34 => cs = cs.push(c"_DQ_"); # "
      36 => cs = cs.push(c"_DL_"); # $
      37 => cs = cs.push(c"_MD_"); # %
      38 => cs = cs.push(c"_AM_"); # &
      39 => cs = cs.push(c"_SQ_"); # '
      42 => cs = cs.push(c"_ML_"); # *
      43 => cs = cs.push(c"_AD_"); # +
      44 => cs = cs.push(c"_CM_"); # ,
      45 => cs = cs.push(c"_SB_"); # -
      46 => cs = cs.push(c"_DT_"); # .
      47 => cs = cs.push(c"_DV_"); # /
      58 => cs = cs.push(c"_CL_"); # :
      59 => cs = cs.push(c"_SC_"); # ;
      60 => cs = cs.push(c"_LT_"); # <
      61 => cs = cs.push(c"_EQ_"); # =
      62 => cs = cs.push(c"_GT_"); # >
      63 => cs = cs.push(c"_QM_"); # ?
      64 => cs = cs.push(c"_AT_"); # @
      91 => cs = cs.push(c"_LB_"); # [
      93 => cs = cs.push(c"_RB_"); # ]
      94 => cs = cs.push(c"_HT_"); # ^
      95 => cs = cs.push(c"_US_"); # _
      96 => cs = cs.push(c"_TK_"); # `
      124 => cs = cs.push(c"_BR_"); # |
      126 => cs = cs.push(c"_TL_"); # ~
      c => cs = cs.push(c);
   }; ci = ci + 1; };
   let result = cs.buffer-into-string;
   result
);

let render-identifier(k: CString, kt: Type): String = (
   let result = render-identifier(k.into(type(String)), kt);
   result
);

let render-identifier(k: String, kt: Type): String = (
   let result = "LM_" + render-identifier(k) + "_" + render-identifier(render-symbolic(kt).replace(" ",""));
   result
);

let render-cstring(cs: CString): String = (
   let s = "\"";
   while non-zero(cs) { match cs {
      c"\""..  rest1 => (s = s + "\\\""; cs = tail(cs););
      c"\\:"..  rest2 => (s = s + ";"; cs = rest2;);
      c"\\["..  rest3 => (s = s + "("; cs = rest3;);
      c"\\]"..  rest4 => (s = s + ")"; cs = rest4;);
      c"\\\\".. rest5 => (s = s + "\\\\"; cs = rest5;);
      c"\\`"..  rest6 => (s = s + "'"; cs = rest6;);
      c"\\l"..  rest7 => (s = s + "λ"; cs = rest7;);
      c"\\n"..  rest8 => (s = s + "\\n"; cs = rest8;);
      c"\\o"..  rest9 => (s = s + "#"; cs = rest9;);
      c"\\s"..  rest10 => (s = s + " "; cs = rest10;);
      c"\\t"..  rest11 => (s = s + "\\t"; cs = rest11;);
      c"\n"..   rest12 => (s = s + "\\n"; cs = rest12;);
      c"\\"..   rest13 => fail("Illegal Escape Character: \{head(rest13)}");
      rest14 => (
         s = s + clone-rope(head(rest14)).into(type(String));
         cs = tail(rest14);
      );
   }};
   let result = s + "\"";
   result
);

let render(tt: Type): String = (
   let result = render-internal(tt.rewrite-type-alias.rewrite-opaque-type-alias);
   result
);
let render-symbolic(tt: Type): String = (
   let result = render-internal(tt.rewrite-type-alias);
   result
);

let render-internal(tt: Type): String = (
   match tt {
      TAnd{ conjugate=conjugate } => (
         let modifiers = "";
         let datatype = "";
         for c in conjugate {
            if c.is-modifier
            then {
               if non-zero(modifiers)
               then modifiers = modifiers + " " + render-internal(c);
               else modifiers = render-internal(c);
            } else if non-zero(datatype) then datatype = datatype + " " + render-internal(c);
              else datatype = render-internal(c);
         };
         if non-zero(modifiers) and non-zero(datatype)
         then modifiers + " " + datatype;
         else modifiers + datatype;
      );
      TGround{tag:interned-tag-array, parameters:[_.. TAny{}..]} => "void*";
      TGround{tag:interned-tag-array, parameters:[_.. array-base..]} => (
         if array-base.is-arrow
         then render(array-base);
         else render(array-base) + "*";
      );
      TGround{tag:interned-tag-c, parameters:[TGround{tag:interned-tag-typedef}..]} => "";
      TGround{tag:interned-tag-c, parameters:[TGround{ctag=tag}..]} => untern(ctag).into(type(String));
      TGround{tag:interned-tag-sized, parameters:[_..]} => "";
      TGround{tag:interned-tag-arrow, parameters:[_.._..]} => (
         "LM_" + render-identifier(tt.into(type(String)));
      );
      TGround{tag2=tag, parameters=parameters} => (
         if not tt.is-datatype then "" else ("LM_" + render-identifier(tt.into(type(String))));
      );
      _ => "";
   }
);
