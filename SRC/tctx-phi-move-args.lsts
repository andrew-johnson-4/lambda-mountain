
let .phi-move-args(tctx: TypeContext?, params: Type, args: Type, blame: AST): TypeContext? = (
   if params.is-t(interned-tag-cons,2) {
      tctx = tctx.phi-move-args(params.slot(interned-tag-cons,2).l1, args.slot(interned-tag-cons,2).l1, blame);
      tctx = tctx.phi-move-args(params.slot(interned-tag-cons,2).l2, args.slot(interned-tag-cons,2).l2, blame);
   } else {
      if not(params.is-t(c"MustNotMove",0)) and not(args.is-t(c"MustNotMove",0)) and args.is-t(c"Phi::State",1) {
         tctx = tctx.phi-move(args, blame);
      };
   };
   tctx
);
