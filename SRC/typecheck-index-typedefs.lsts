
let index-typedef-fields = {} : Hashtable<(CString,U64),Vector<(Type,Type)>>;
let index-typedef = {} : Hashtable<(CString,U64),AST>;
let index-fields-of = {} : Hashtable<(CString,U64,CString),Vector<(CString,Type)>>;
let index-cases-of = {} : Hashtable<(CString,U64),Vector<CString>>;

let index-typedefs(program: AST): Nil = (
   for def in program.unroll-seq { match def {
      Typedef{} => (
         let lhs-type = (def as Tag::Typedef).lhs-type;
         let cases = (def as Tag::Typedef).cases;
         let has-cases = false;
         for case in cases {
            if non-zero(case.first) {
               has-cases = true;
               index-index-of-tag(case.first, 0);
               if case.second.length == 0 then index-lone-tag(case.first);
            };
            if not(has-cases) {
               index-index-of-tag(lhs-type.simple-tag, 0);
            };
            for case-field in case.second {
               let fields-types = index-typedef-fields.lookup(lhs-type.ground-tag-and-arity, mk-vector(type((Type,Type))));
               fields-types = fields-types.push((lhs-type,case-field.second));
               index-typedef-fields = index-typedef-fields.bind(lhs-type.ground-tag-and-arity,fields-types);
            }
         };
         if cases.length>0 then index-typedef = index-typedef.bind(lhs-type.ground-tag-and-arity, def);

         let cases-of = mk-vector(type(CString));
         let common-fields = mk-vector(type((CString,Type)));
         # index fields-of
         for case in cases {
            if not(non-zero(case.first)) then common-fields = case.second;
         };
         let gta = lhs-type.ground-tag-and-arity;
         index-fields-of = index-fields-of.bind((gta.first, gta.second, c""), common-fields);
         for case in cases {
            let uncommon-fields = common-fields.clone;
            if non-zero(case.first) {
               cases-of = cases-of.push(case.first);
               for kv in case.second {
                  uncommon-fields = uncommon-fields.push(kv);
               };
               index-fields-of = index-fields-of.bind((gta.first, gta.second, c"Tag::" + case.first), uncommon-fields);
            };
         };
         if cases-of.length==0 then cases-of = cases-of.push(c"");
         index-cases-of = index-cases-of.bind(gta, cases-of);
      );
      _ => ();
   }};
);
