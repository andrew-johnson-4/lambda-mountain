# new allocations = 0 (constant)
let type-c-vararg = t1(interned-tag-c,t0(c"..."));

# new allocations = 0 (constant)
let type-c-tany = t1(interned-tag-c,ta);

# new allocations = 0 (constant)
let type-c-typedef = t1(interned-tag-c,t0(c"typedef"));

# new allocations = 0 (constant)
let type-array-c-typedef = t2(interned-tag-array,t1(interned-tag-c,t0(c"typedef")),ta);

