# new allocations = 0
let ta = TAny;

# new allocations = 0
#    0 from 0 length vector
let t0(tag: CString): Type = TGround(intern-type-tag(tag), mk-vector(type(Type)));
let t0(tag: TypeTagIntern): Type = TGround(tag, mk-vector(type(Type)));

# new allocations = 0
let ti(id: U32): Type = TId(id);

# new allocations = 1
#    1 from 1 length vector
let t1(tag: CString, p1: Type): Type = TGround(intern-type-tag(tag), mk-vector(type(Type)).push(p1));
let t1(tag: TypeTagIntern, p1: Type): Type = TGround(tag, mk-vector(type(Type)).push(p1));

# new allocations = 1
#    1 from 2 length vector
let t2(tag: CString, p1: Type, p2: Type): Type = TGround(intern-type-tag(tag), mk-vector(type(Type)).push(p2).push(p1));
let t2(tag: TypeTagIntern, p1: Type, p2: Type): Type = TGround(tag, mk-vector(type(Type)).push(p2).push(p1));

# new allocations = 0
let tv(name: CString): Type = TVar(name, mk-vector(type(Type)));

# new allocations = 0
let tvs(name: CString, ps: Vector<Type>): Type = TVar(name, ps);

# new allocations = 1
let tv1(name: CString, p1: Type): Type = TVar(name, mk-vector(type(Type)).push(p1));

# new allocations = 1
let tv1(name: CString, p2: Type): Type = TVar(name, mk-vector(type(Type)).push(p1).push(p2));

# new allocations = 0 (constant)
let type-nil = t0(c"Nil");

# new allocations = 0 (constant)
let type-any = t0(c"Any");

# new allocations = 0 (constant)
let type-tail-position = t0(interned-tag-tail-position);

# new allocations = 0 (constant)
let type-lazy = tv(c"lazy");

# new allocations = 0 (constant)
let type-release-phi-moved = t1(c"MustRelease::ToRelease",t1(interned-tag-linear,t0(interned-tag-phi-moved)));

# new allocations = 0 (constant)
let type-type-string = t1(c"Type",t0(c"String"));

# new allocations = 0 (constant)
let type-cstring-literal = t0(c"CString") && t0(c"Literal");

# new allocations = 0 (constant)
let type-linear-moved = t1(interned-tag-linear,t0(interned-tag-phi-moved));

# new allocations = 0 (constant)
let type-linear-live = t1(interned-tag-linear,t0(interned-tag-phi-live));

