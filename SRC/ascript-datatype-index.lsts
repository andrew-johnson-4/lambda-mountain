
# All datatypes must be registered as such here

let datatype-index = mk-set(type((U32,U32)));

let .is-datatype(tt: Type): Bool = (
   match tt {
      TAnd{conjugate=conjugate} => (
         let found = false;
         for c in conjugate {
            found = found or c.is-datatype;
         };
         found
      );
      _ => (
         let gta = tt.ground-tag-and-arity;
         datatype-index.has(gta)
      );
   }
);

let .is-datatype-or-cons-datatype(tt: Type): Bool = (
   match tt {
      TGround{tag:interned-tag-cons, parameters:[p2..p1..]} => p2.is-datatype-or-cons-datatype or p1.is-datatype-or-cons-datatype;
      _ => tt.is-datatype;
   }
);
