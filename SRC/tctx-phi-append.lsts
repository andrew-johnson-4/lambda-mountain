
let .phi-append(tctx-primary: TypeContext?, tctx-secondary: TypeContext?): TypeContext? = (
   tctx-primary.with-pctx( tctx-primary.get-or(mk-tctx()).pctx.phi-append(tctx-secondary.get-or(mk-tctx()).pctx,false) ) 
);

let .phi-append-dead-on-arrival(tctx-primary: TypeContext?, tctx-secondary: TypeContext?): TypeContext? = (
   tctx-primary.with-pctx( tctx-primary.get-or(mk-tctx()).pctx.phi-append(tctx-secondary.get-or(mk-tctx()).pctx,true) ) 
);

let .phi-append(tctx-primary: PBTree<U64,PhiContextRow>, tctx-secondary: PBTree<U64,PhiContextRow>, dead-on-arrival: Bool): PBTree<U64,PhiContextRow> = (
   if is(tctx-primary, tctx-secondary) then tctx-primary
   else if not(non-zero(tctx-primary)) then tctx-secondary
   else if not(non-zero(tctx-secondary)) then tctx-primary
   else {
      # 1. Flatten both trees into sorted vectors O(N + M)
      let v1 = tctx-primary.as-vector();
      let v2 = tctx-secondary.as-vector();
      
      # 2. Merge sorted vectors O(N + M)
      let merged = merge-phi-vectors(v1, v2, dead-on-arrival);
      
      # 3. Rebuild balanced PBTree O(N + M)
      merged.as-pbtree
   }
);

let merge-phi-vectors(v1: Vector<(U64,PhiContextRow)>, v2: Vector<(U64,PhiContextRow)>, doa: Bool): Vector<(U64,PhiContextRow)> = (
   let out = mk-vector(type((U64,PhiContextRow)), v1.length + v2.length);
   let i = 0_sz;
   let j = 0_sz;
   
   while i < v1.length and j < v2.length {
      (let k1, let row1) = v1[i];
      (let k2, let row2) = v2[j];
      
      if k1 < k2 {
         out = out.push((k1, row1)); i = i + 1;
      } else if k2 < k1 {
         if doa then row2 = row2.with-phi-tt(row2.phi-tt-or-zero.move-linear);
         out = out.push((k2, row2)); j = j + 1;
      } else {
         # Keys are equal: Apply your merge logic [cite: 885, 892]
         if doa then {
            # Prefer the primary if secondary is DOA [cite: 541, 544]
            out = out.push((k1, row1));
         } else {
            let merged-tt = global-flow-tctx.phi-merge(row1.phi-tt-or-zero, row2.phi-tt-or-zero, row1.blame-or-zero);
            out = out.push((k1, row1.with-phi-tt(merged-tt)));
         };
         i = i + 1; j = j + 1;
      };
   };
   
   # Append remainders
   while i < v1.length { out = out.push(v1[i]); i = i + 1; };
   while j < v2.length { 
      let row = v2[j].second;
      if doa then row = row.with-phi-tt(row.phi-tt-or-zero.move-linear);
      out = out.push((v2[j].first, row)); 
      j = j + 1; 
   };
   out
);

let build-pbtree-from-sorted-vector(v: Vector<(U64,PhiContextRow)>): PBTree<U64,PhiContextRow> = (
   build-pbtree-recursive(v, 0_sz, v.length)
);

let build-pbtree-recursive(v: Vector<(U64,PhiContextRow)>, start: USize, end: USize): PBTree<U64,PhiContextRow> = (
   let len = end - start;
   if len <= 0_sz then mk-pbtree(type(U64), type(PhiContextRow))
   else if len == 1_sz {
      (let k, let val) = v[start];
      PBNode1(k, val, close(PBLeaf), close(PBLeaf))
   } else if len == 2_sz {
      (let k1, let v1) = v[start];
      (let k2, let v2) = v[start + 1_sz];
      PBNode2(k1, v1, k2, v2, close(PBLeaf), close(PBLeaf), close(PBLeaf))
   } else {
      # Split into three roughly equal parts for a 2-3 Tree node
      let third = len / 3_sz;
      let mid1 = start + third;
      let mid2 = start + 2_sz * third;
      
      (let k1, let val1) = v[mid1];
      (let k2, let val2) = v[mid2];
      
      PBNode2(
         k1, val1, k2, val2,
         close(build-pbtree-recursive(v, start, mid1)),
         close(build-pbtree-recursive(v, mid1 + 1_sz, mid2)),
         close(build-pbtree-recursive(v, mid2 + 1_sz, end))
      )
   }
);
