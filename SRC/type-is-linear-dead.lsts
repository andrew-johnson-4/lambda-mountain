
let .is-linear-dead(tt: Type): Bool = (
   match tt {
      TAnd{conjugate=conjugate} => (
         let return = false;
         for c in conjugate { return = return or c.is-linear-dead };
         return
      );
      TGround{tag:interned-tag-linear,parameters:[TGround{tag:interned-tag-phi-moved,parameters:[]}..]} => true;
      TGround{parameters=parameters} => (
         let return = false;
         for c in parameters { return = return or c.is-linear-dead };
         return
      );
      _ => false;
   }
);
