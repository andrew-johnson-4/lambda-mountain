
let release-locals(tctx-before: PBTree<k,v>, tctx-after: PBTree<k,v>, tctx-after-iter: PBTree<k,v>, pid-seen: Set<U32>): (Set<U32>, PBTree<k,v>) = (
   if is(tctx-before,tctx-after) then (pid-seen, tctx-after)
   else match tctx-after-iter {
      PBLeaf{} => (pid-seen, tctx-after);
      PBNode1{ k11=k1, v11=v1, left=left, right=right } => (
         if v11.dead-on-arrival-or-zero and not(pid-seen.has(v11.phi-id-or-zero)) and v11.phi-tt-or-zero.is-linear-live {
            pid-seen = pid-seen.bind(v11.phi-id-or-zero);
            tctx-after = tctx-after.bind(v11.phi-id-or-zero, v11.with-phi-tt(v11.phi-tt-or-zero.move-linear));
         };
         (pid-seen, tctx-after) = release-locals(tctx-before, tctx-after, left, pid-seen);
         (pid-seen, tctx-after) = release-locals(tctx-before, tctx-after, right, pid-seen);
         (pid-seen, tctx-after)
      );
      PBNode2{ k12=k1, v12=v1, k22=k2, v22=v2, left=left, mid=mid, right=right } => (
         if v12.dead-on-arrival-or-zero and not(pid-seen.has(v12.phi-id-or-zero)) and v12.phi-tt-or-zero.is-linear-live {
            pid-seen = pid-seen.bind(v12.phi-id-or-zero);
            tctx-after = tctx-after.bind(v12.phi-id-or-zero, v12.with-phi-tt(v12.phi-tt-or-zero.move-linear));
         };
         if v22.dead-on-arrival-or-zero and not(pid-seen.has(v22.phi-id-or-zero)) and v22.phi-tt-or-zero.is-linear-live {
            pid-seen = pid-seen.bind(v22.phi-id-or-zero);
            tctx-after = tctx-after.bind(v22.phi-id-or-zero, v22.with-phi-tt(v22.phi-tt-or-zero.move-linear));
         };
         (pid-seen, tctx-after) = release-locals(tctx-before, tctx-after, left, pid-seen);
         (pid-seen, tctx-after) = release-locals(tctx-before, tctx-after, mid, pid-seen);
         (pid-seen, tctx-after) = release-locals(tctx-before, tctx-after, right, pid-seen);
         (pid-seen, tctx-after)
      );
   };
);

let release-locals(tctx-before: TypeContext?, tctx-after: TypeContext?, term: AST, hint: Type, release-self: Bool): (TypeContext?, AST) = (
   tctx-after = tctx-after.phi-append-dead-on-arrival(tctx-before);
   let tctx-before-tctx = tctx-before.get-or(mk-tctx()).tctx;
   let tctx-after-tctx = tctx-after.get-or(mk-tctx()).tctx;
   let tctx-before-pctx = tctx-before.get-or(mk-tctx()).pctx;
   let tctx-after-pctx = tctx-after.get-or(mk-tctx()).pctx;
   let needs-release = [] : List<TypeContextRow>;
   let needs-mark-release = [] : List<TypeContextRow>;
   let pid-seen = mk-set(type(U32));
   while non-zero(tctx-after-tctx) and not(is(tctx-before-tctx, tctx-after-tctx)) {
      let tr = head(tctx-after-tctx);
      let dt = tctx-after.with-phi(tr.denormalized, term);
      if dt.slot(interned-tag-phi-state,1).l1.slot(interned-tag-must-release-to-release,1).is-linear-live {
         if dt.is-t(interned-tag-must-not-retain,0)
         then needs-mark-release = cons(tr, needs-mark-release)
         else needs-release = cons(tr, needs-release);
      };
      tctx-after-tctx = tail(tctx-after-tctx);
   };
   if non-zero(needs-release) {
      let return-id = uuid();
      let return-type = typeof-term(term);
      let rhs = term;
      let def = mk-var(return-id);
      if not(return-type.is-t(interned-tag-nil,0)) and not(return-type.is-t(interned-tag-never,0)) {
         term = mk-app( mk-abs(def, mk-nil(), ta), term ); tctx-after = tctx-after.ascript(term, type-nil);
         (tctx-after, let binding-type) = std-bind-term(tctx-after, return-id, rhs, def, term, hint);
         tctx-after = tctx-after.ascript(def, binding-type);
      };
      for nd in needs-release {
         pid-seen = pid-seen.bind(nd.denormalized.slot(interned-tag-phi-id,1).l1.simple-id);
         let do-release = mk-cons(
            mk-app(mk-var(c".release"),mk-var(nd.key-or-zero)),
            mk-app(mk-var(c"destroy"),mk-var(nd.key-or-zero))
         );
         (tctx-after, do-release) = std-infer-expr(tctx-after, do-release, false, Used, ta);
         term = mk-cons(term, do-release); tctx-after = tctx-after.ascript(term, type-nil);
      };
      let return-term = if not(return-type.is-t(interned-tag-nil,0)) and not(return-type.is-t(interned-tag-never,0))
      then mk-var(return-id)
      else mk-nil();
      (tctx-after, return-term) = std-infer-expr(tctx-after, return-term, false, Used, t0(interned-tag-must-not-retain));
      if typeof-term(return-term).is-linear-live then tctx-after = tctx-after.phi-move(typeof-term(return-term), term);
      term = mk-cons(term, return-term); tctx-after = tctx-after.ascript(term,return-type);
   };
   for nd in needs-mark-release {
      pid-seen = pid-seen.bind(nd.denormalized.slot(interned-tag-phi-id,1).l1.simple-id);
      tctx-after = tctx-after.phi-move(tctx-after.with-phi(nd.denormalized, term), term);
   };
   (pid-seen, tctx-after-pctx) = release-locals(tctx-before-pctx, tctx-after-pctx, tctx-after-pctx, pid-seen);
   tctx-after.with-pctx(tctx-after-pctx);
   tctx-before = tctx-before.phi-append(tctx-after);
   if not(release-self) then (tctx-before, _) = tctx-before.resurrect(typeof-term(term), term);
   (tctx-before.prune-moved, term)
);
