
typed macro macro::define-zero(base-type: lazy, constructor: lazy, con-tag: lazy): lazy = {
   let non-zero(t: base-type): Bool = t.discriminator-case-tag != (t as con-tag).discriminator-case-tag;
};

typed macro $"assert"(c: lazy): lazy = (
   if not c then fail(c"Assertion Failed At ", macro::location(c));
);

typed macro macro::let-binding(v: lazy): lazy = (v);
typed macro macro::set-binding(v: lazy): lazy = (v);

typed macro macro::maybe-let(lhs: macro::underscore, rhs: lazy): Nil = (
   rhs; ();
);
typed macro macro::maybe-let(lhs: macro::variable, rhs: lazy): Nil = (
   (fn(lhs) = ()) (rhs)
);
typed macro macro::let(lhs: macro::let-binding, rhs: lazy): lazy = (
   macro::maybe-let(lhs, rhs)
);

typed macro macro::let(lhs: macro::variable, rhs: lazy): lazy = (
   macro::maybe-set(lhs, rhs)
);
typed macro macro::let(lhs: macro::underscore, rhs: lazy): lazy = (
   macro::maybe-set(lhs, rhs)
);

typed macro macro::maybe-set(lhs: macro::underscore, rhs: lazy): Nil = (
   rhs; ();
);
typed macro macro::maybe-set(lhs: macro::variable, rhs: lazy): Nil = (
   mov(rhs, lhs)
);
typed macro macro::let(lhs: macro::set-binding, rhs: lazy): lazy = (
   macro::maybe-set(lhs, rhs)
);

typed macro macro::lhs-index(base: lazy, index: lazy): lazy = (base; index);

typed macro macro::assign(lhs-base lhs-index: macro::lhs-index, rhs: lazy): Nil = (
   $"set[]"(lhs-base, lhs-index, rhs)
);
typed macro macro::fallible-bind(lhs-base lhs-index: macro::lhs-index, rhs: lazy): Bool = (
   $"set[]"(lhs-base, lhs-index, rhs); true
);

typed macro macro::assign(lhs-base lhs-field-name: macro::lhs-field, rhs: lazy): Nil = (
   macro::concat($"set.", lhs-field-name)(macro::lhs-as-rhs(lhs-base), rhs)
);
typed macro macro::fallible-bind(lhs-base lhs-field-name: macro::lhs-field, rhs: lazy): Bool = (
   macro::concat($"set.", lhs-field-name)(macro::lhs-as-rhs(lhs-base), rhs); true
);

typed macro macro::assign(lhs: macro::variable, rhs: lazy): Nil = (
   mov(rhs, lhs)
);
typed macro macro::fallible-bind(lhs: macro::variable, rhs: lazy): Bool = (
   macro::maybe-let(lhs; rhs); true
);

typed macro macro::assign(lhs: macro::let-binding, rhs: lazy): Nil = (
   macro::maybe-let(lhs, rhs)
);
typed macro macro::fallible-bind(lhs: macro::let-binding, rhs: lazy): Bool = (
   macro::fallible-bind(lhs, rhs)
);

typed macro macro::assign(lhs: macro::set-binding, rhs: lazy): Nil = (
   macro::maybe-set(lhs, rhs)
);
typed macro macro::fallible-bind(lhs: macro::set-binding, rhs: lazy): Bool = (
   macro::maybe-set(lhs, rhs); true
);

typed macro macro::assign(lhs: macro::underscore, rhs: lazy): Nil = (
   rhs; ();
);
typed macro macro::fallible-bind(lhs: macro::underscore, rhs: lazy): Bool = (
   rhs; true;
);

typed macro macro::set(lhs: lazy, rhs: lazy): lazy = (
   mov(rhs, lhs)
);

typed macro macro::set(base index: macro::lhs-index, rhs: lazy): lazy = (
   $"set[]"( base, index, rhs )
);

typed macro macro::set(base field: macro::lhs-field, rhs: lazy): lazy = (
   macro::concat($"set.", field) (macro::lhs-as-rhs(base), rhs)
);

typed macro :Lazy macro::lhs-as-rhs(v: macro::variable): lazy = (
   v
);

typed macro :Lazy macro::lhs-as-rhs(base idx: macro::lhs-index): lazy = (
   macro::lhs-as-rhs(base)[idx]
);

typed macro :Lazy macro::lhs-as-rhs(base: macro::lhs-address-of): lazy = (
   &v
);

typed macro :Lazy macro::lhs-as-rhs(base field: macro::lhs-field): lazy = (
   macro::concat($".", field)(macro::lhs-as-rhs(base))
);

typed macro macro::lhs-address-of(base: lazy): lazy = (
   base
);

typed macro macro::lhs-field(base: lazy, field: lazy): lazy = (
   base; field
);

typed macro macro::lhs-index(base: lazy, index: lazy): lazy = (
   base; index
);

typed macro macro::lhs-index(base field: macro::lhs-field, index: lazy): lazy = (
   macro::concat($".", field)(base); index
);

typed macro macro::while(cond: Bool, body: lazy): lazy = (
   primitive::while( cond, body as Nil )
);

typed macro macro::for(item: lazy, iterable: List<?>, loop: lazy): lazy = (
   let uuid(iter-term) = iterable;
   while non-zero(uuid(iter-term)) {
      if macro::fallible-bind(item, open(head(uuid(iter-term))))
      then loop;
      uuid(iter-term) = tail(uuid(iter-term));
   };
);

typed macro macro::for(item: lazy, iterable: Vector<?>, loop: lazy): lazy = (
   let uuid(iter-term) = iterable;
   let uuid(iter-i) = 0_sz;
   while uuid(iter-i) < uuid(iter-term).length {
      if macro::fallible-bind(item, open(uuid(iter-term)[uuid(iter-i)]))
      then loop;
      uuid(iter-i) = uuid(iter-i) + 1;
   };
);

typed macro macro::for(item: lazy, iterable: VectorView<?>, loop: lazy): lazy = (
   let uuid(iter-term) = iterable;
   let uuid(iter-i) = 0_sz;
   while uuid(iter-i) < uuid(iter-term).length {
      if macro::fallible-bind(item, open(uuid(iter-term)[uuid(iter-i)]))
      then loop;
      uuid(iter-i) = uuid(iter-i) + 1;
   };
);

typed macro macro::match(t: lazy, ps: lazy): lazy = (scope(
   let uuid(term) = open(t);
   macro::match-pats( uuid(term), ps, fail(c"Pattern Match Failure ", macro::location(t)) );
));

typed macro macro::match(t: macro::bind-raw, ps: lazy): lazy = (scope(
   let uuid(term) = t;
   macro::match-pats( uuid(term), ps, fail(c"Pattern Match Failure ", macro::location(t)) );
));

typed macro macro::match(f t: macro::bind-raw-field, ps: lazy): lazy = (scope(
   let uuid(term) = f($"raw"(t));
   macro:: match-pats( uuid(term), ps, fail(c"Pattern Match Failure ", macro::location(t)) );
));

typed macro macro::match-pats(term: lazy, cases: macro::pats-none, remainder: lazy): lazy = (
   remainder
);

typed macro macro::match-pats(term: lazy, ps lhs rhs: macro::pats-some, remainder: lazy): lazy = (
   macro::match-pats(term, ps, scope($"if"(macro::match-pats-arm(term,lhs))(rhs)(remainder)));
);

typed macro macro::pats-some(ps: lazy, lhs: lazy, rhs: lazy): lazy = (
   ps; lhs; rhs
);

typed macro macro::pats-none(ignore: lazy): lazy = (
   ()
);

typed macro macro::lhs-tagged(tag-guard: lazy, fields-guard: lazy): lazy = (
   tag-guard; fields-guard;
);

typed macro macro::lhs-fields-field(field-key: macro::variable, pat: lazy): lazy = (
   field-key; pat;
);

typed macro macro::lhs-fields(prefix: lazy, fields: lazy): lazy = (
   prefix; fields;
);


