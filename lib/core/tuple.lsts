

type Tuple<x,y> implies MustRetain, MustRelease = { first: x, second: y };
type Tuple<x,y,z> implies MustRetain, MustRelease = { first: x, second: y, third: z };
type Tuple<w,x,y,z> implies MustRetain, MustRelease = { first: w, second: x, third: y, fourth: z };

typed macro $".0"(t: Tuple<x,y>): x = ($".first"(t));
typed macro $".0"(t: Tuple<x,y,z>): x = ($".first"(t));
typed macro $".0"(t: Tuple<w,x,y,z>): w = ($".first"(t));
typed macro $"set.0"(t: Tuple<x,y>, v: x): Nil = ($"set.first"(t,v));
typed macro $"set.0"(t: Tuple<x,y,z>, v: x): Nil = ($"set.first"(t,v));
typed macro $"set.0"(t: Tuple<w,x,y,z>, v: w): Nil = ($"set.first"(t,v));

typed macro $".1"(t: Tuple<x,y>): y = ($".second"(t));
typed macro $".1"(t: Tuple<x,y,z>): y = ($".second"(t));
typed macro $".1"(t: Tuple<w,x,y,z>): x = ($".second"(t));
typed macro $"set.1"(t: Tuple<x,y>, v: y): Nil = ($"set.second"(t,v));
typed macro $"set.1"(t: Tuple<x,y,z>, v: y): Nil = ($"set.second"(t,v));
typed macro $"set.1"(t: Tuple<w,x,y,z>, v: x): Nil = ($"set.second"(t,v));

typed macro $".2"(t: Tuple<x,y,z>): z = ($".third"(t));
typed macro $".2"(t: Tuple<w,x,y,z>): y = ($".third"(t));
typed macro $"set.2"(t: Tuple<x,y,z>, v: z): Nil = ($"set.third"(t,v));
typed macro $"set.2"(t: Tuple<w,x,y,z>, v: y): Nil = ($"set.third"(t,v));

typed macro $".3"(t: Tuple<w,x,y,z>): z = ($".fourth"(t));
typed macro $"set.3"(t: Tuple<w,x,y,z>, v: z): Nil = ($"set.fourth"(t,v));

let cmp(l: Tuple<x,y>, r: Tuple<x,y>): Ord = (
   cmp(l.first, r.first) && cmp(l.second, r.second)
);

let hash(l: Tuple<x,y>): U64 = (
   hash(l.first) + hash(l.second)
);

let .into(l: Tuple<x,y>, tt: Type<String>): String = (
   "(" + l.first.into(type(String)) + ","
       + l.second.into(type(String)) + ")"
);

let cmp(l: Tuple<x,y,z>, r: Tuple<x,y,z>): Ord = (
   cmp(l.first, r.first) && cmp(l.second, r.second) && cmp(l.third, r.third)
);

let hash(l: Tuple<x,y,z>): U64 = (
   hash(l.first) + hash(l.second) + hash(l.third)
);

let .into(l: Tuple<x,y,z>, tt: Type<String>): String = (
   "(" + l.first.into(type(String)) + ","
       + l.second.into(type(String)) + ","
       + l.third.into(type(String)) + ")"
);

let cmp(l: Tuple<w,x,y,z>, r: Tuple<w,x,y,z>): Ord = (
   cmp(l.first, r.first) && cmp(l.second, r.second) && cmp(l.third, r.third) && cmp(l.fourth, r.fourth)
);

let hash(l: Tuple<w,x,y,z>): U64 = (
   hash(l.first) + hash(l.second) + hash(l.third) + hash(l.fourth)
);

let .into(l: Tuple<w,x,y,z>, tt: Type<String>): String = (
   "(" + l.first.into(type(String)) + ","
       + l.second.into(type(String)) + ","
       + l.third.into(type(String)) + ","
       + l.fourth.into(type(String)) + ")"
);
