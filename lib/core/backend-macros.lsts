
typed macro macro::backend::render(t: macro::constant): lazy = (
   t
);

typed macro macro::backend::render(t: macro::ast::lit): lazy = (
   t
);

typed macro macro::backend::render(t: macro::ast::type): lazy = (
   t
);

typed macro macro::backend::render(t: macro::ast::typedef): lazy = (
   ()
);

typed macro macro::backend::render(t: macro::ast::glb): lazy = (
   t
);

typed macro macro::backend::render(t tt: macro::ast::as): lazy = (
   t as tt
);

typed macro macro::backend::render(c t f: macro::ast::if): lazy = (
   if c then t else f
);

typed macro macro::backend::render(lhs rhs: macro::ast::let): lazy = (
   (fn (lhs) = ())(rhs)
);
